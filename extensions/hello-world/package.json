{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "hello-world",
  "title": "Hello World",
  "description": "Minimal seed extension demonstrating the monorepo Makefile workflow.",
  "icon": "extension-icon.png",
  "author": "jakeobsen",
  "license": "MIT",
  "categories": ["Fun"],
  "commands": [
    {
      "name": "say-hello",
      "title": "Say Hello",
      "description": "Shows a greeting HUD.",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.12"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.1.1",
    "@types/node": "^22.14.0",
    "eslint": "^9.0.0",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --relaxed --fix",
    "lint": "ray lint --relaxed",
    "lint-publish": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
